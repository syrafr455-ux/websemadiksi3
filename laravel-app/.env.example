APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Supabase). Ambil nilainya dari Supabase Dashboard > Connect > "Session pooler".
# Jangan commit kredensial asli; isi hanya di .env.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_SSLMODE=require
# Schema terpisah agar tidak bentrok dengan tabel public.users milik app Next.js.
# Buat dulu di SQL Editor: CREATE SCHEMA IF NOT EXISTS laravel;
DB_SEARCH_PATH=laravel

# Password akun demo dari `php artisan db:seed` (seeder ditolak di production).
# Kosongkan agar akun demo baru mendapat password acak yang ditampilkan sekali di terminal.
# Akun demo yang sudah ada hanya diganti passwordnya bila variabel ini diisi.
SEED_ADMIN_PASSWORD=
SEED_MAHASISWA_PASSWORD=

# Sumber data akademik UNUSA & status penerima KIP-K: database (tabel lokal hasil impor CSV) | api (kerangka, belum diimplementasikan).
UNUSA_ACADEMIC_PROVIDER=database
KIP_RECIPIENT_PROVIDER=database
# Cache daftar ruangan UNUSA (detik); 0 = tanpa cache.
UNUSA_FACILITIES_CACHE_TTL=300
# Cek DNS (MX) domain email pada aturan email:rfc,dns. Biarkan true; phpunit.xml mematikannya untuk tes.
VALIDASI_EMAIL_DNS=true

# Domain email mahasiswa yang boleh menerima link aktivasi (dipisah koma, domain persis).
UNUSA_STUDENT_EMAIL_DOMAINS=student.unusa.ac.id
# Jalur pendaftaran "Mahasiswa Umum" disembunyikan sementara (404). Ubah ke true untuk menampilkan.
REGISTRASI_UMUM_AKTIF=false

# Klien API UNUSA (hanya bila UNUSA_ACADEMIC_PROVIDER=api; lihat docs/api-unusa.md). Server produksi mungkin butuh VPN / IP tetap.
UNUSA_API_BASE_URL=
UNUSA_API_ISSUER=
UNUSA_API_CLIENT_ID=
UNUSA_API_CLIENT_SECRET=
UNUSA_API_SCOPE=
UNUSA_API_PATH_MAHASISWA=/mahasiswa/{nim}

# Zona waktu aplikasi & database tetap UTC (config/app.php); input/tampilan WIB diatur di kode (App\Support\Wib).
# APP_TIMEZONE tidak dibaca aplikasi.

# Pembayaran HTM (Tripay). Isi kredensial asli hanya di .env.
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_SANDBOX=true
TRIPAY_RETURN_URL="${APP_URL}/dashboard/kegiatan-saya"
PAYMENT_EXPIRY_MINUTES=60
PAYMENT_FALLBACK_PHONE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_IDLE_TIMEOUT_MINUTES=15

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengiriman email lewat SMTP Gmail (tanpa layanan pihak ketiga). Untuk produksi:
#   MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587
#   MAIL_USERNAME = akun Gmail pengirim
#   MAIL_PASSWORD = sandi aplikasi Google (bukan sandi akun)
#   MAIL_FROM_ADDRESS = harus sama dengan MAIL_USERNAME
# Uji dengan: php artisan semadiksi:tes-email alamat@contoh.com. Email aktivasi lewat antrean, jadi worker (queue:work) harus berjalan.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SSO Keycloak UNUSA (OAuth2 / OIDC). Fitur aktif hanya bila KEYCLOAK_ENABLED=true serta base URL & secret terisi.
KEYCLOAK_ENABLED=false
KEYCLOAK_BASE_URL=
KEYCLOAK_REALMS=UNUSA
KEYCLOAK_CLIENT_ID=simadiksi
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_NIM_CLAIM=preferred_username
KEYCLOAK_LOGOUT_ENABLED=false
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=
KEYCLOAK_FORCE_LOGIN_PROMPT=true

# Role yang wajib 2FA saat login dengan kata sandi (user_umum,penilai_karya)
TWO_FACTOR_ROLES=user_umum,penilai_karya

# Batas waktu inaktivitas sesi pengguna (menit); halaman umum 15 menit, mode kios/pemindai 240 menit (4 jam)
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_KIOSK_IDLE_TIMEOUT_MINUTES=240
